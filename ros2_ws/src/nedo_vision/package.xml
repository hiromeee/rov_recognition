<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nedo_vision</name>
  <version>0.1.0</version>
  <description>NEDO Challenge Vision Recognition Node for ROS2 Jazzy</description>
  <maintainer email="hiro28me@gmail.com">Hirokazu Tanaka</maintainer>
  <license>MIT</license>

  <exec_depend>vision_pipeline_pkg</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>bluehacks_rov_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
